{
  // The venv lives OUTSIDE the repo, at ~/.venvs/moba, on purpose: /mnt/c is a
  // 9p bridge to the Windows drive and cannot be hard-linked from uv's cache,
  // so an in-repo .venv gets fully copied (uv sync 11 min vs 1.5 s).
  // See CLAUDE.md. This is a WSL-remote workspace, so the path is a Linux path.
  "python.defaultInterpreterPath": "/home/ubuntu/.venvs/moba/bin/python",

  // Keep integrated terminals pointed at the same env, so a bare `uv run`
  // typed by hand doesn't silently recreate the slow in-repo venv.
  "terminal.integrated.env.linux": {
    "UV_PROJECT_ENVIRONMENT": "/home/ubuntu/.venvs/moba"
  },

  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],

  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true
  }
}
